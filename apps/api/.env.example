# Copy this file to .env and adjust as needed for local development.
# infra/docker/docker-compose.dev.yml sets these automatically for the
# containerized API — this file is mainly for running the API directly
# on your host machine (outside Docker) against the Compose Postgres/Redis.

DATABASE_URL=postgresql+asyncpg://nickcosmetics:nickcosmetics@localhost:5432/nickcosmetics
REDIS_URL=redis://localhost:6379/0

JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# Paystack / Flutterwave test keys go here once payments are wired up (Phase 6)
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=
